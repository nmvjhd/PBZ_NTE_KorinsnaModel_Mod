# ==============================================================================
# 本仓库不包含任何第三方 / 游戏资产，也不包含可以用脚本重建的产物。
# 每一条都注明了原因；新增规则请放到对应分组里。
# ==============================================================================

# ---------------------------------------------------------------- 模型与第三方素材
# 可琳思娜模型、魂（游戏原模型）、参考模组：均无二次分发权利
KorinsnaModel/
REFERENCE/
*.blend
*.blend1
*.psk
*.pskx
*.fbx
*.zip
# 从游戏二进制导出的映射文件
*.usmap

# ---------------------------------------------------------------- 截图 / 图片
# 游戏画面与模型渲染图，一律不进仓库
docs/img/
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tga

# ---------------------------------------------------------------- 实验工程与临时副本
# 只留在本地磁盘，不提交
IK_Retarget_Project/
backup/

# ---------------------------------------------------------------- 构建产物（脚本可重建）
dist/
blender/out/
ue/*/Binaries/
ue/*/DerivedDataCache/
ue/*/Intermediate/
ue/*/Saved/
ue/*/Content/
ue/*/Plugins/*/Content/
ue/*/*.sln
ue/*/.vs/

# ---------------------------------------------------------------- 研发 dump
# 构建日志与自动生成报告不进仓库，仅保留骨骼参考表 refbones.txt
extract/*
!extract/dump/
extract/dump/*
!extract/dump/refbones.txt

# ---------------------------------------------------------------- release
Release/
Release/*

# ---------------------------------------------------------------- 通用忽略
*.log
__pycache__/
*.pyc
.vscode/
*.suo
*.user
*.VC.db
*.opensdf
*.sdf
Thumbs.db
desktop.ini
